<dbmodel pgmodeler-ver="0.9.2" last-position="0,86" last-zoom="0.95" max-obj-count="4"
	 default-owner="postgres">
<database name="arenda_db" is-template="false" allow-conns="true">
</database>

<schema name="public" layer="0" fill-color="#e1e1e1" sql-disabled="true">
</schema>

<table name="точка" layer="0" collapse-mode="2" max-obj-count="6">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="180" y="180"/>
	<column name="floor" not-null="true">
		<type name="int2" length="0"/>
	</column>
	<column name="square" not-null="true">
		<type name="int2" length="0"/>
	</column>
	<column name="conditioner">
		<type name="bool" length="0"/>
	</column>
	<column name="price_day" not-null="true">
		<type name="decimal" length="0"/>
	</column>
	<column name="id" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<constraint name="точка_pk" type="pk-constr" table="public.&quot;точка&quot;">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_price" type="ck-constr" table="public.&quot;точка&quot;">
			<expression><![CDATA[price_day>-1]]></expression>
	</constraint>
	<constraint name="chk_square" type="ck-constr" table="public.&quot;точка&quot;">
			<expression><![CDATA[square>0]]></expression>
	</constraint>
	<initial-data>
<![CDATA[этаж•площадь•кондиционер•прайс_день•id⸣
1•200•true•500•1⸣
2•350•false•450•2⸣
1•400•true•700•3]]>
	</initial-data>
</table>

<table name="клиент" layer="0" collapse-mode="2" max-obj-count="7">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="560" y="100"/>
	<column name="name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="adress">
		<type name="text" length="0"/>
	</column>
	<column name="phone" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="requisites">
		<type name="text" length="0"/>
	</column>
	<column name="contact_name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="id" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<constraint name="клиент_pk" type="pk-constr" table="public.&quot;клиент&quot;">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<initial-data>
<![CDATA[имя•адрес•телефон•реквизиты•контактное лицо•id⸣
Филатов А.А.•Баргузинская,49•21-94-93•12345678•Филатов А.А•1⸣
ИП Мокин•Промышленная, 3•22-31-34•23456789•Мокин А.М.•2⸣
ООО Сервико•Бабушкина,43•20-21-55•34567890•Панкратов Р.Н.•3]]>
	</initial-data>
</table>

<table name="договор" layer="0" collapse-mode="2" max-obj-count="6">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="800" y="500"/>
	<column name="end_rent" not-null="true">
		<type name="date" length="0"/>
	</column>
	<column name="id" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<column name="begin_rent">
		<type name="date" length="0"/>
	</column>
	<constraint name="договор_pk" type="pk-constr" table="public.&quot;договор&quot;">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_date" type="ck-constr" table="public.&quot;договор&quot;">
			<expression><![CDATA[end_rent-begin_rent>=0]]></expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_клиент" index="1"/>
		<object name="id_точка" index="4"/>
	</customidxs>

	<customidxs object-type="constraint">
		<object name="клиент_fk" index="1"/>
		<object name="точка_fk" index="2"/>
	</customidxs>
	<initial-data>
<![CDATA[конец аренды•id_клиент•id•начало аренды•id_точка⸣
17.09.2023•1•1•08.04.2023•1⸣
08.04.2024•2•2•08.04.2023•2]]>
	</initial-data>
</table>

<relationship name="клиент_has_many_договор" type="rel1n" layer="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#c618c4"
	 src-table="public.&quot;клиент&quot;"
	 dst-table="public.&quot;договор&quot;"
	 src-required="true" dst-required="false">
	<label ref-type="name-label">
		<position x="1.99741" y="5.46774"/>
	</label>
</relationship>

<relationship name="точка_has_many_договор" type="rel1n" layer="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#2858c1"
	 src-table="public.&quot;точка&quot;"
	 dst-table="public.&quot;договор&quot;"
	 src-required="true" dst-required="false">
	<label ref-type="name-label">
		<position x="-8.79238" y="2.67111"/>
	</label>
</relationship>

<table name="оплата" layer="0" collapse-mode="2" max-obj-count="6">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="100" y="460"/>
	<column name="month">
		<type name="decimal" length="0"/>
	</column>
	<column name="year">
		<type name="decimal" length="0"/>
	</column>
	<column name="payment">
		<type name="decimal" length="0"/>
	</column>
	<column name="id" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<constraint name="прайс_pk" type="pk-constr" table="public.&quot;оплата&quot;">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_payment" type="ck-constr" table="public.&quot;оплата&quot;">
			<expression><![CDATA[payment>0]]></expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_договор" index="4"/>
	</customidxs>

	<customidxs object-type="constraint">
		<object name="договор_fk" index="1"/>
	</customidxs>
	<initial-data>
<![CDATA[месяц•год•стоимость•id•id_договор⸣
1•2023•15000•1•1]]>
	</initial-data>
</table>

<relationship name="договор_has_many_оплата" type="rel1n" layer="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#b7a799"
	 src-table="public.&quot;договор&quot;"
	 dst-table="public.&quot;оплата&quot;"
	 src-required="true" dst-required="false"/>

</dbmodel>
