        <mxCell id="GydJzuyY3k9jI1CnQE96-16" value="&lt;span style=&quot;font-family: &amp;#34;verdana&amp;#34; , &amp;#34;arial&amp;#34; , sans-serif ; font-size: medium ; background-color: rgb(255 , 255 , 255)&quot;&gt;Зависимость – это связь&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;define&quot; style=&quot;padding: 0px ; margin: 0px ; outline: none ; color: rgb(128 , 0 , 0) ; font-weight: bold ; font-style: italic ; font-family: &amp;#34;verdana&amp;#34; , &amp;#34;arial&amp;#34; , sans-serif ; font-size: medium ; background-color: rgb(255 , 255 , 255)&quot;&gt;использования&lt;/span&gt;&lt;span style=&quot;font-family: &amp;#34;verdana&amp;#34; , &amp;#34;arial&amp;#34; , sans-serif ; font-size: medium ; background-color: rgb(255 , 255 , 255)&quot;&gt;, указывающая, что &lt;br&gt;изменение спецификаций одной сущности может&lt;br&gt;&amp;nbsp;повлиять на другие сущности,&lt;br&gt;&amp;nbsp;которые используют ее.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
