<?xml version="1.0" encoding="UTF-8"?>
<!--
CAUTION: Do not modify this file unless you know what you are doing.
         Unexpected results may occur if the code is changed deliberately.
-->
<dbmodel pgmodeler-ver="0.9.2" last-position="0,0" last-zoom="0.9" max-obj-count="4"
	 default-schema="public" default-owner="postgres">
<database name="rent_db" is-template="false" allow-conns="true">
</database>

<schema name="public" layer="0" fill-color="#e1e1e1" sql-disabled="true">
</schema>

<table name="точка" layer="0" collapse-mode="2" max-obj-count="7">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="160" y="260"/>
	<column name="этаж" not-null="true">
		<type name="int2" length="0"/>
	</column>
	<column name="площадь" not-null="true">
		<type name="int2" length="0"/>
	</column>
	<column name="кондиционер">
		<type name="bool" length="0"/>
	</column>
	<column name="прайс" not-null="true">
		<type name="decimal" length="0"/>
	</column>
	<column name="id" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="точка_pk" type="pk-constr" table="public.&quot;точка&quot;">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="клиент" layer="0" collapse-mode="2" max-obj-count="7">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="600" y="180"/>
	<column name="имя" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="адрес">
		<type name="text" length="0"/>
	</column>
	<column name="телефон" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="реквизиты">
		<type name="text" length="0"/>
	</column>
	<column name="конт_лицо" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="id" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="клиент_pk" type="pk-constr" table="public.&quot;клиент&quot;">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="договор" layer="0" collapse-mode="2" max-obj-count="4">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="580" y="520"/>
	<column name="точка" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="клиент" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="срок_рент" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="договор_pk" type="pk-constr" table="public.&quot;договор&quot;">
		<columns names="клиент" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="клиент_has_many_точка" type="rel1n" layer="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#039e50"
	 src-table="public.&quot;клиент&quot;"
	 dst-table="public.&quot;точка&quot;"
	 src-required="false" dst-required="false"/>

<relationship name="клиент_has_many_договор" type="rel1n" layer="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#c618c4"
	 src-table="public.&quot;клиент&quot;"
	 dst-table="public.&quot;договор&quot;"
	 src-required="true" dst-required="false"/>

</dbmodel>
